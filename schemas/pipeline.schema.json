{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wfp.local/schemas/pipeline.schema.json",
  "title": "WFP Pipeline",
  "description": "工作项契约规范。Implements: DR-20, DR-21, DR-26, DR-27。YAML 为唯一真源（ADR-01）。",
  "type": "object",
  "required": ["apiVersion", "meta", "steps"],
  "additionalProperties": false,
  "properties": {
    "apiVersion": { "const": "wfp/v1" },
    "meta": {
      "type": "object",
      "required": ["id", "name"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "version": { "type": "string" },
        "workdir": { "type": "string", "description": "workspace 根，默认 YAML 所在目录（DR-24）" },
        "allow_outside_workspace": { "type": "boolean", "default": false }
      }
    },
    "inputs": { "type": "object", "description": "运行输入的 JSON Schema（DR-27）" },
    "vars": { "type": "object" },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "node": { "type": "string", "description": "'current' 或节点 id（DR-51）" },
        "timeout_seconds": { "type": "number", "minimum": 1 },
        "on_error": { "enum": ["fail", "continue", "compensate"] },
        "retry": { "$ref": "#/$defs/retry" }
      }
    },
    "steps": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/step" } }
  },
  "$defs": {
    "retry": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "attempts": { "type": "integer", "minimum": 0 },
        "backoff": { "enum": ["fixed", "exponential"] },
        "delay_seconds": { "type": "number", "minimum": 0 }
      }
    },
    "step": {
      "type": "object",
      "required": ["id", "uses"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z][\\w-]*$", "description": "图节点 id 恒等于此（DR-45/46）" },
        "name": { "type": "string" },
        "uses": { "type": "string", "pattern": "^([a-z][a-z0-9_.]*@\\d+\\.\\d+\\.\\d+|pipeline:[a-z][a-z0-9_-]*@\\d+\\.\\d+\\.\\d+)$", "description": "精确版本固定（DR-16）或子工作项（DR-22）" },
        "with": { "type": "object" },
        "node": { "type": "string" },
        "when": { "type": "string", "description": "受限表达式（DR-25）" },
        "loop": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "for_each": { "type": ["string", "array"] },
            "while": { "type": "string" },
            "max_iterations": { "type": "integer", "minimum": 1, "maximum": 1000, "default": 1000 }
          },
          "oneOf": [{ "required": ["for_each"] }, { "required": ["while"] }]
        },
        "register": { "type": "string", "description": "输出注册到作用域（DR-23）" },
        "timeout_seconds": { "type": "number", "minimum": 1 },
        "retry": { "$ref": "#/$defs/retry" },
        "on_error": { "enum": ["fail", "continue", "compensate"], "default": "fail" },
        "compensate": {
          "type": "object", "additionalProperties": false,
          "properties": { "uses": { "type": "string" }, "with": { "type": "object" }, "mode": { "enum": ["auto", "manual", "none"] } }
        }
      }
    }
  }
}
